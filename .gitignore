node_modules/
dist/
.refs/
*.local.json
# 개인 계정 데이터 — 저장소에 올리지 않는다
data/accounts/
# 하네스 실행 중 상태
.harness/lock.json
.harness/runs/**/agent.log
__pycache__/
*.pyc
# 데스크톱 앱(app/)의 설치·빌드 산출물. app/package-lock.json과 app/src-tauri/Cargo.lock은 커밋한다
app/node_modules/
app/dist/
app/src-tauri/target/
# tauri-build가 빌드할 때마다 다시 만드는 권한 스키마와 앱 명령 권한(build.rs의 명령 목록에서 나온다)
app/src-tauri/gen/schemas/
app/src-tauri/permissions/autogenerated/
data/captures/
# 받아 둔 게임 이미지·아이콘(scripts/fetch-assets.mjs --run) — 게임사의 권리물이라 저장소에 넣지 않는다
data/assets/
# 시뮬 결과 캐시 — 다시 계산하면 나오는 값이다(docs/data-model.md §시뮬 결과 캐시)
data/cache/
# 설치판 업데이트 서명 비밀
*.key
*.key.password
