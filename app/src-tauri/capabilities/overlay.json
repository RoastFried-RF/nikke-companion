{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "오버레이 창이 쓰는 것만 허용한다: 상태·진행 이벤트 듣기, 창 끌기, 앱 명령 열여섯 개(결과 읽기·상태·끝내기, 엔진 카탈로그·버전·배치 실행·중단, JSON 파일 읽기·고르기, 게임 창 상태·붙이기·화면 저장·화면 인식, 화면 자동 추적 켜기/끄기·상태). 파일·셸·네트워크 플러그인 권한은 없다. 중복 실행 방지(single-instance)는 화면에서 부르는 것이 없어 권한이 없다.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-load-report",
    "allow-overlay-status",
    "allow-startup-report-path",
    "allow-quit-app",
    "allow-engine-catalog",
    "allow-engine-version",
    "allow-engine-run-batch",
    "allow-engine-cancel",
    "allow-read-json-file",
    "allow-pick-json-file",
    "allow-game-window-status",
    "allow-set-follow-game",
    "allow-capture-game",
    "allow-recognize-game-screen",
    "allow-set-screen-tracking",
    "allow-screen-track-status"
  ]
}
