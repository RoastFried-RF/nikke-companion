{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "오버레이 창이 쓰는 것만 허용한다: 상태 이벤트 듣기, 창 끌기, 앱 명령 네 개. 파일·셸·네트워크 권한은 없다.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-load-report",
    "allow-overlay-status",
    "allow-startup-report-path",
    "allow-quit-app"
  ]
}
