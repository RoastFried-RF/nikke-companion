{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "오버레이 창(main)이 쓰는 것만 허용한다: 상태·진행 이벤트 듣기, 창 끌기, 앱 명령 스물다섯 개(결과 읽기·상태·끝내기, 엔진 카탈로그·버전·배치 실행·중단, JSON 파일 읽기·고르기, 게임 창 상태·붙이기·화면 저장·화면 인식, 화면 자동 추적 켜기/끄기·상태, 계정 받기 — 상태·쿠키 저장·프로필 수집·수집 중단·받은 프로필 읽기·계정 파일 저장, 로그인 창 열기·쿠키 가져오기·세션 지우기). 파일·셸·네트워크 플러그인 권한은 없다. 중복 실행 방지(single-instance)는 화면에서 부르는 것이 없어 권한이 없다. blablalink 로그인 창(login)은 여기에 없다 — 그 창에는 권한이 하나도 없고, 원격 주소에 IPC를 여는 설정(remote)도 두지 않는다.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-load-report",
    "allow-overlay-status",
    "allow-startup-report-path",
    "allow-quit-app",
    "allow-engine-catalog",
    "allow-engine-version",
    "allow-engine-run-batch",
    "allow-engine-cancel",
    "allow-read-json-file",
    "allow-pick-json-file",
    "allow-game-window-status",
    "allow-set-follow-game",
    "allow-capture-game",
    "allow-recognize-game-screen",
    "allow-set-screen-tracking",
    "allow-screen-track-status",
    "allow-account-sync-status",
    "allow-account-save-cookie",
    "allow-account-fetch-profile",
    "allow-account-fetch-cancel",
    "allow-account-read-profile",
    "allow-account-save-file",
    "allow-login-window-open",
    "allow-login-window-take-cookie",
    "allow-login-window-clear"
  ]
}
